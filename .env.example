# Copy to .env for local runs (never commit .env). On Render these are set in the dashboard (render.yaml: sync: false).
# Without them the server runs as before: everyone is a guest with local saves.

# The Supabase project's URL (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# The project's secret key (starts with sb_secret_): server only. Never in public/, the client, or the CrazyGames build.
SUPABASE_SECRET_KEY=
